# ==============================================================
# Telegram Mini App: Refer & Earn + GigaPub Ads Configuration
# ==============================================================

# 1. Telegram Bot Token from @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Telegram Bot Username without @
BOT_USERNAME=YourBotUsername

# 3. Admin Telegram Numeric ID (Get it from @userinfobot or @raw_data_bot)
ADMIN_ID=1234567890

# 4. Admin Secret Key / Password for Web Dashboard Login
ADMIN_SECRET=admin123456

# 5. Server Port
PORT=3000

# 6. Public URL of your deployed Mini App (e.g. https://your-domain.com or ngrok URL)
WEBAPP_URL=http://localhost:3000

# 7. Official Support Telegram Username (without @)
SUPPORT_USERNAME=YourSupportUsername

# 8. GigaPub Ad Network Credentials (from https://gigapub.tech dashboard)
GIGAPUB_PROJECT_ID=8839
GIGAPUB_API_KEY=
GIGAPUB_APP_ID=

# 9. Economy & Rewards
CURRENCY_NAME=₹
CURRENCY_SYMBOL=₹
POINTS_PER_INR=1

REFERRAL_REWARD=20.00
DAILY_BONUS=0.50
AD_REWARD=5.00

MIN_WITHDRAWAL=500.00
MAX_WITHDRAWAL=10000.00

# 10. Ads System Controls
AD_COOLDOWN_SECONDS=20
DAILY_AD_LIMIT=0
MAX_DAILY_AD_EARNINGS=25.00

# 11. LibTL / Monetag Ad SDK & Direct Sponsor Links
LIBTL_ZONE_ID=12128125
AD_DIRECT_LINK_1=https://uplcm.com/4/11717959
AD_DIRECT_LINK_2=https://uplcm.com/4/11717884

# 12. Adsterra SmartLink for High Revenue
ADSTERRA_SMARTLINK=https://arwf.org/4/ef8f2a6df3e5243a89a484add434af25

# 13. MongoDB Atlas Cloud Persistence (Recommended for Vercel)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/telegram_bot?retryWrites=true&w=majority
MONGODB_URI=

# 14. Maintenance Mode (true/false)
MAINTENANCE_MODE=false
